// Copy to repo-root Secrets.xcconfig (gitignored) and fill in your key.
// Used by DiaryVault/Config/DiaryVault.xcconfig → Info.plist at Archive / TestFlight time.
// Never commit Secrets.xcconfig. Scheme Run env is enough for local Debug only.
//
// Get a key: https://console.x.ai → API Keys

DIARY_AI_API_KEY = xai-your-key-here
// Optional overrides (defaults: openai/xai → https://api.x.ai + grok-4.7):
// DIARY_AI_PROVIDER = openai
// DIARY_AI_BASE_URL = https://api.x.ai
// DIARY_AI_MODEL = grok-4.7
