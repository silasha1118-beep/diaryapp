rules_version = '2';

// DiaryVault — paste into Firebase Console → Firestore → Rules → Publish.
// Clients may only read/write their own users/{uid} tree.
// Admin / console / Admin SDK bypass these rules.
// In-repo Vault-like viewer: firebase/admin (owner signs in; same rules).
// Entry deletes are soft-only: clients update deleted/deletedAt/status; hard delete is denied
// so diary docs remain under users/{uid}/entries forever.
service cloud.firestore {
  match /databases/{database}/documents {
    // aliyunOtpSessions/{id} — Admin SDK only (Cloud Functions). No client match → deny.

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function entrySoftDeleteFieldsOk() {
      return (!('deleted' in request.resource.data)
          || request.resource.data.deleted is bool)
        && (!('deletedAt' in request.resource.data)
          || request.resource.data.deletedAt is timestamp);
    }

    // Profile doc path = Firebase Auth UID. ownerUid must match; identity fields
    // (phoneNumber, appleUserId, displayName, authProviders) are optional extras
    // for Console lookup — never replace the path key with phone/Apple id.
    match /users/{userId} {
      allow read, create, update: if isOwner(userId)
        && request.resource.data.ownerUid == userId;
      allow delete: if isOwner(userId);

      // Diary entries. entryId MUST stay the DiaryEntry UUID (not phone+datetime).
      // Optional: label, bodyPreview, status ("active"|"deleted"), hasMedia,
      // moodTag, deleted, deletedAt, attachments[], sourcePlatform ("ios"|"android").
      // contentType is "text" or "multimedia". Soft-delete only — no hard delete.
      // Media metadata on this doc; bytes in Storage users/{uid}/entries/{entryId}/{fileName}.
      match /entries/{entryId} {
        allow read: if isOwner(userId);

        allow create, update: if isOwner(userId)
          && request.resource.data.ownerUid == userId
          && request.resource.data.id == entryId
          && request.resource.data.keys().hasAll([
            'id', 'title', 'body', 'createdAt', 'updatedAt',
            'ownerUid', 'schemaVersion', 'contentType'
          ])
          && request.resource.data.schemaVersion is int
          && request.resource.data.contentType is string
          && entrySoftDeleteFieldsOk();

        // Forever retention: clients must soft-delete via update (deleted/deletedAt).
        allow delete: if false;
      }
    }
  }
}
