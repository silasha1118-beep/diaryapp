# Copy to .env for emulator only — never commit real values.
# Production (PowerShell): set Secret Manager secrets, then deploy — see ../ALIYUN_SMS.md
#   firebase functions:secrets:set ALIYUN_SMS_ACCESS_KEY_ID
#   firebase functions:secrets:set ALIYUN_SMS_ACCESS_KEY_SECRET
#   firebase functions:secrets:set ALIYUN_SMS_SIGN_NAME
#   firebase functions:secrets:set ALIYUN_SMS_TEMPLATE_CODE
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
# ALIYUN_SMS_TEMPLATE_PARAM_KEY=code
# Allow local OTP when keys are empty (emulator / pre-Console) — never in prod:
ALIYUN_SMS_ALLOW_STUB=true

# Operator Vault admin password (emulator). Production: set Firebase secret instead:
#   firebase functions:secrets:set ADMIN_VAULT_PASSWORD
ADMIN_VAULT_PASSWORD=
