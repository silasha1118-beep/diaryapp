    <string name="auth_sms_rate_limited">Too many attempts — try again later.</string>
    <string name="auth_sms_billing_required">Live SMS needs the Firebase project on the Blaze (pay-as-you-go) plan. Upgrade in Firebase Console, then try again.</string>
    <string name="auth_sms_region_blocked">SMS isn’t available for this number’s region right now. Try again later or use another number.</string>
    <string name="auth_sms_app_verification">Couldn’t finish the security check. Close any browser page that opened, then try again — or use a real phone with Google Play.</string>
    <string name="auth_sms_recaptcha_unavailable">Security check needs Google Play or a browser. On emulator: add this number under Firebase Console → Authentication → Phone → Phone numbers for testing and enter the fixed test code, or use a real phone.</string>
    <string name="auth_sms_recaptcha_browser_failed">The browser security page failed (or Chrome stopped responding). Close that page, return here, and try again. Prefer a real phone with Google Play — emulator Chrome is unreliable.</string>
    <string name="auth_sms_timed_out">Request timed out. Close any security browser page if it’s still open, then try again — or use a real phone with Google Play.</string>
    <string name="auth_sms_sent_hint">Check Messages for the SMS. No text usually means this number is still on Firebase “Phone numbers for testing” (fixed Console code only), or Blaze / SMS region is not ready — then tap Resend.</string>
