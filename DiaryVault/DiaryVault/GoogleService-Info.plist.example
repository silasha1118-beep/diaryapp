<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  EXAMPLE ONLY — do NOT rename this file to GoogleService-Info.plist and commit secrets.

  Silas: you already downloaded the real GoogleService-Info.plist for Firebase project
  `diaryappsilas` (bundle ID com.silasha.diaryvault). Keep that real file LOCAL only:

  1. Copy your real plist next to this example as:
       DiaryVault/DiaryVault/GoogleService-Info.plist
     A Run Script build phase copies that path into the app bundle automatically.
     Leave DIARY_SMS_PROVIDER empty so the app auto-selects Firebase.
  2. Optional: drag into the DiaryVault Xcode group with Target Membership —
     not required when the file sits at the path above.
  3. REVERSED_CLIENT_ID is REQUIRED for Phone Auth. Info.plist commits
     non-empty CFBundleURLTypes placeholders; scripts/inject-firebase-url-schemes.py
     (Run Script phase) replaces them with REVERSED_CLIENT_ID + encoded
     GOOGLE_APP_ID at build time. Value looks like:
       com.googleusercontent.apps.1234567890-abcdef
     If REVERSED_CLIENT_ID is missing: enable Google sign-in in Firebase
     Console → re-download this plist → replace the local file → Clean Build
     Folder → delete app from phone → reinstall.
  4. Phone Auth also needs Console SMS region policy allowing
     TW / HK / CN / MY / SG / TH / JP (see README “Tonight: receive a real SMS”).
     App code does not change Firebase Console — you must allow these regions.
  5. Login UI should show “SMS provider: Firebase” — if it still says Stub,
     clear any scheme env DIARY_SMS_PROVIDER=stub and confirm the file path.

  Real GoogleService-Info.plist is gitignored.
-->
<plist version="1.0">
<dict>
	<key>CLIENT_ID</key>
	<string>REPLACE_ME.apps.googleusercontent.com</string>
	<key>REVERSED_CLIENT_ID</key>
	<string>com.googleusercontent.apps.REPLACE_ME</string>
	<key>API_KEY</key>
	<string>REPLACE_ME</string>
	<key>GCM_SENDER_ID</key>
	<string>REPLACE_ME</string>
	<key>PLIST_VERSION</key>
	<string>1</string>
	<key>BUNDLE_ID</key>
	<string>com.silasha.diaryvault</string>
	<key>PROJECT_ID</key>
	<string>diaryappsilas</string>
	<key>STORAGE_BUCKET</key>
	<string>diaryappsilas.appspot.com</string>
	<key>IS_ADS_ENABLED</key>
	<false/>
	<key>IS_ANALYTICS_ENABLED</key>
	<false/>
	<key>IS_APPINVITE_ENABLED</key>
	<true/>
	<key>IS_GCM_ENABLED</key>
	<true/>
	<key>IS_SIGNIN_ENABLED</key>
	<true/>
	<key>GOOGLE_APP_ID</key>
	<string>1:REPLACE_ME:ios:REPLACE_ME</string>
</dict>
</plist>
