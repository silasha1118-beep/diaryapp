<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<!-- First-market locales: zh-Hant / zh-Hans / en (TW·HK·CN·MY·SG) + ja (JP) + th (TH). -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>zh-Hant</string>
		<string>zh-Hans</string>
		<string>ja</string>
		<string>th</string>
	</array>
	<key>CFBundleDisplayName</key>
	<string>Diary Vault</string>
	<!-- Standard HTTPS only (Firebase Auth, StoreKit, cloud AI). No custom crypto → export compliance = No. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<!-- Silent push for Firebase Phone Auth app verification (APNs path; avoids reCAPTCHA). -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!--
	  Firebase Phone Auth reCAPTCHA callback schemes.
	  MUST stay non-empty: Firebase Auth stores CFBundleURLTypes as an IUO
	  (`Auth.mainBundleUrlTypes`). An absent/stripped empty array makes that nil, and
	  PhoneAuthProvider.init force-unwraps it (fatal at PhoneAuthProvider.swift:649).
	  The Copy GoogleService-Info.plist Run Script replaces the DIARYVAULT_* placeholders
	  with REVERSED_CLIENT_ID + encoded GOOGLE_APP_ID from the gitignored plist.
	-->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>Firebase Phone Auth REVERSED_CLIENT_ID</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.DIARYVAULT_REVERSED_CLIENT_ID</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>Firebase Phone Auth Encoded App ID</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>app-1-DIARYVAULT_GOOGLE_APP_ID</string>
			</array>
		</dict>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Optional cloud AI — leave empty in repo; set via Xcode scheme env instead. -->
	<key>DIARY_AI_PROVIDER</key>
	<string></string>
	<key>DIARY_AI_BASE_URL</key>
	<string></string>
	<key>DIARY_AI_API_KEY</key>
	<string></string>
	<key>DIARY_AI_MODEL</key>
	<string></string>
	<key>DIARY_AI_MAX_TOKENS</key>
	<string></string>
	<key>DIARY_AI_MAX_CONTEXT_ENTRIES</key>
	<string></string>
	<key>DIARY_AI_DAILY_REQUEST_LIMIT</key>
	<string></string>
	<!-- Optional IAP product ID overrides — leave empty to use BillingConfig defaults. Never put secrets here. -->
	<!-- Legacy aliases still read by BillingConfig if PLUS_* keys are empty. -->
	<key>DIARY_IAP_MONTHLY_PRODUCT_ID</key>
	<string></string>
	<key>DIARY_IAP_YEARLY_PRODUCT_ID</key>
	<string></string>
	<key>DIARY_IAP_PLUS_MONTHLY_PRODUCT_ID</key>
	<string></string>
	<key>DIARY_IAP_PLUS_QUARTERLY_PRODUCT_ID</key>
	<string></string>
	<key>DIARY_IAP_PLUS_YEARLY_PRODUCT_ID</key>
	<string></string>
	<key>DIARY_IAP_PRO_MONTHLY_PRODUCT_ID</key>
	<string></string>
	<key>DIARY_IAP_PRO_QUARTERLY_PRODUCT_ID</key>
	<string></string>
	<key>DIARY_IAP_PRO_YEARLY_PRODUCT_ID</key>
	<string></string>
	<key>DIARY_AI_PRO_DAILY_REQUEST_LIMIT</key>
	<string></string>
	<key>DIARY_AI_FREE_SOFT_PAYWALL_THRESHOLD</key>
	<string></string>
	<!-- Hosted legal pages for App Store subscription disclosure. Empty → in-app privacy sheet + Apple Standard EULA. -->
	<!-- Requires GitHub Pages: Settings → Pages → Deploy from a branch → main / docs (see README). -->
	<key>DIARY_PRIVACY_POLICY_URL</key>
	<string>https://silasha1118-beep.github.io/diaryapp/privacy.html</string>
	<key>DIARY_TERMS_OF_USE_URL</key>
	<string></string>
	<!-- SMS OTP — leave empty. Empty → firebase when GoogleService-Info.plist is bundled (Run Script copies DiaryVault/GoogleService-Info.plist), else stub. Explicit stub only when you set "stub". Never put secrets here. -->
	<key>DIARY_SMS_PROVIDER</key>
	<string></string>
	<key>DIARY_SMS_STUB_CODE</key>
	<string></string>
	<key>DIARY_FIREBASE_PROJECT_ID</key>
	<string>diaryappsilas</string>
	<key>DIARY_TWILIO_ACCOUNT_SID</key>
	<string></string>
	<key>DIARY_TWILIO_AUTH_TOKEN</key>
	<string></string>
	<key>DIARY_TWILIO_VERIFY_SERVICE_SID</key>
	<string></string>
</dict>
</plist>
